# SIGINEX · variables de entorno (ejemplo) — copiar a .env y ajustar
# Base de datos
DB_PASSWORD=change-me
DATABASE_URL=postgresql://siginex:change-me@db:5432/siginex

# API keys por tenant (separadas por coma). En producción usar un gestor de secretos.
SIGINEX_API_KEYS=demo-key

# Vigilancia (opcional)
SIGINEX_TZ=America/Bogota
